<view class="page-cart">
  <!-- 自己的选菜车 -->
  <view class="section" wx:if="{{!isFromShare}}">
    <view class="section-title">我选的菜</view>

    <view class="cart-list" wx:if="{{items.length > 0}}">
      <view class="cart-item" wx:for="{{items}}" wx:key="id">
        <image class="item-img" src="{{item.image_url || '/assets/default-dish.png'}}" mode="aspectFill"/>
        <view class="item-info">
          <view class="item-name">{{item.name}}</view>
          <view class="price">{{item.price}}</view>
        </view>
        <view class="item-remove" bindtap="onRemoveItem" data-id="{{item.id}}">移除</view>
      </view>
    </view>

    <view class="empty" wx:else>
      <text class="empty-icon">🍽</text>
      <text>还没选菜呢</text>
      <navigator url="/pages/index/index" class="btn-outline" style="margin-top:20rpx">去选菜</navigator>
    </view>

    <!-- 底部操作栏 -->
    <view class="cart-footer" wx:if="{{items.length > 0}}">
      <view class="footer-left">
        <text class="footer-count">共 {{items.length}} 道</text>
        <text class="price footer-total">{{totalPrice}}</text>
      </view>
      <view class="footer-right">
        <view class="btn-text" bindtap="onClearCart">清空</view>
        <button class="btn-primary btn-share" bindtap="onCreateAndShare" open-type="share">
          分享菜单
        </button>
      </view>
    </view>
  </view>

  <!-- 来自分享的点菜单 -->
  <view class="section" wx:if="{{isFromShare}}">
    <view class="section-title">朋友的菜单</view>

    <view class="cart-list" wx:if="{{shareItems.length > 0}}">
      <view class="cart-item" wx:for="{{shareItems}}" wx:key="id">
        <image class="item-img" src="{{item.dish_image || '/assets/default-dish.png'}}" mode="aspectFill"/>
        <view class="item-info">
          <view class="item-name">{{item.dish_name}}</view>
          <view class="price">{{item.dish_price}}</view>
        </view>
      </view>
    </view>

    <view class="share-total">
      <text>合计：</text>
      <text class="price">{{shareTotalPrice}}</text>
    </view>

    <view class="share-actions">
      <navigator url="/pages/index/index" class="btn-primary">我也去选菜</navigator>
    </view>
  </view>
</view>
