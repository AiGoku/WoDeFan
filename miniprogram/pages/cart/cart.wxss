.page-cart {
  padding: 20rpx;
  padding-bottom: 200rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.cart-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-item:last-child {
  border-bottom: none;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
}

.item-remove {
  color: #999;
  font-size: 26rpx;
  padding: 10rpx 20rpx;
}

/* 底部操作栏 */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.footer-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.footer-count {
  font-size: 26rpx;
  color: #666;
}

.footer-total {
  font-size: 36rpx;
}

.footer-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn-text {
  color: #999;
  font-size: 28rpx;
  padding: 10rpx;
}

.btn-share {
  margin: 0;
  padding: 0 40rpx;
  height: 80rpx;
  line-height: 80rpx;
}

/* 分享页面的合计 */
.share-total {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  padding: 24rpx;
  gap: 8rpx;
  font-size: 30rpx;
}

.share-total .price {
  font-size: 40rpx;
}

.share-actions {
  margin-top: 40rpx;
  padding: 0 24rpx;
}
