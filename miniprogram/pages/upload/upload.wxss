.page-upload {
  padding: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 30rpx;
  text-align: center;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.btn {
  background: #FF6B35;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
}

.btn[disabled] {
  background: #ccc;
}

.status {
  padding: 20rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.progress {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress text {
  font-size: 24rpx;
  color: #999;
}

.tips {
  margin-top: 30rpx;
  padding: 20rpx;
  background: #FFF8E1;
  border-radius: 12rpx;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tip {
  font-size: 22rpx;
  color: #666;
  line-height: 1.8;
}
