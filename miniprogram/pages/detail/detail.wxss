.page-detail {
  padding-bottom: 140rpx;
}

.dish-hero {
  width: 100%;
  height: 500rpx;
  display: block;
}

.dish-body {
  padding: 30rpx;
}

.dish-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.dish-name {
  font-size: 40rpx;
  font-weight: 700;
}

.dish-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.dish-meta {
  display: flex;
  gap: 16rpx;
}

.meta-tag {
  padding: 8rpx 20rpx;
  background: #FFF3ED;
  color: #FF6B35;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.btn-share {
  flex: 1;
  background: #fff;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
  border-radius: 40rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  height: 80rpx;
}

.btn-add {
  flex: 2;
  background: #FF6B35;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  height: 80rpx;
}

.btn-add.active {
  background: #999;
}
