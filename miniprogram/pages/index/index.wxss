.page-index {
  padding-bottom: 120rpx;
}

/* 当季推荐 */
.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  padding: 24rpx 24rpx 16rpx;
}

.recommend-scroll {
  white-space: nowrap;
}

.recommend-list {
  display: inline-flex;
  padding: 0 24rpx 16rpx;
  gap: 20rpx;
}

.recommend-item {
  width: 240rpx;
  flex-shrink: 0;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.recommend-img {
  width: 240rpx;
  height: 180rpx;
  display: block;
}

.recommend-name {
  padding: 12rpx 16rpx 4rpx;
  font-size: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recommend-item .price {
  padding: 0 16rpx 12rpx;
  font-size: 26rpx;
}

/* 分类标签 */
.category-tabs {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
  background: #F5F5F5;
}

.tab.active {
  background: #FF6B35;
  color: #fff;
}

/* 菜品列表 */
.dish-list {
  padding: 0 24rpx;
}

.dish-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.dish-img {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
}

.dish-desc {
  font-size: 24rpx;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

/* 浮动购物车按钮 */
.float-cart {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: #FF6B35;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.4);
  z-index: 100;
}

.cart-icon {
  font-size: 48rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: #FF3B30;
  color: #fff;
  font-size: 22rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}
