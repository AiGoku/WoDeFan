<view class="page-index">
  <!-- 当季推荐 -->
  <view class="section" wx:if="{{recommended.length > 0}}">
    <view class="section-title">当季推荐</view>
    <scroll-view scroll-x class="recommend-scroll">
      <view class="recommend-list">
        <view class="recommend-item" wx:for="{{recommended}}" wx:key="_id"
              bindtap="onDishTap" data-id="{{item._id}}">
          <image class="recommend-img" src="{{item.image_url || '/assets/default-dish.png'}}" mode="aspectFill"/>
          <view class="recommend-name">{{item.name}}</view>
          <view class="price">{{item.price}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 分类标签 -->
  <scroll-view scroll-x class="category-tabs">
    <view class="tab {{activeCategory === item.key ? 'active' : ''}}"
          wx:for="{{categories}}" wx:key="key"
          bindtap="onCategoryTap" data-key="{{item.key}}">
      {{item.name}}
    </view>
  </scroll-view>

  <!-- 菜品列表 -->
  <view class="dish-list" wx:if="{{!loading}}">
    <view class="dish-card" wx:for="{{dishes}}" wx:key="_id"
          bindtap="onDishTap" data-id="{{item._id}}">
      <image class="dish-img" src="{{item.image_url || '/assets/default-dish.png'}}" mode="aspectFill"/>
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-desc text-gray">{{item.description}}</view>
        <view class="dish-bottom">
          <view class="price">{{item.price}}</view>
          <view class="add-btn" catchtap="onAddToCart" data-dish="{{item}}">+</view>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{dishes.length === 0}}">
      <text class="empty-icon">🍽</text>
      <text>暂无菜品</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 浮动购物车按钮 -->
  <view class="float-cart" bindtap="goToCart">
    <view class="cart-icon">🛒</view>
    <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
  </view>
</view>
