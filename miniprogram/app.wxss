page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
  background-color: #F5F5F5;
  box-sizing: border-box;
}

.container {
  padding: 20rpx;
}

/* 通用颜色 */
.text-primary { color: #FF6B35; }
.text-gray { color: #999; }
.text-bold { font-weight: 600; }

/* 通用按钮 */
.btn-primary {
  background: #FF6B35;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
}

.btn-outline {
  background: #fff;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
  border-radius: 40rpx;
  padding: 18rpx 38rpx;
  font-size: 30rpx;
  text-align: center;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

/* 价格 */
.price {
  color: #FF6B35;
  font-weight: 600;
  font-size: 32rpx;
}

.price::before {
  content: '¥';
  font-size: 24rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}
